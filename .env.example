# Copy to /etc/usos-watcher/.env on the VPS, chmod 0600, owner root:usoswatch.
# Never commit the real .env. Never log these values.

# --- USOS (UW) credentials ---
USOS_USERNAME=
USOS_PASSWORD=

# --- Telegram (primary notifier) ---
# Create the bot with @BotFather, then send it any message; get your chat id
# from   https://api.telegram.org/bot<TOKEN>/getUpdates   (look for chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP (optional, only if you want email fallback — currently unused) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional overrides
USOS_WATCHER_CONFIG=/opt/usos-watcher/app/config.yaml
USOS_WATCHER_STATE=/var/lib/usos-watcher/state.json
USOS_WATCHER_LOG_DIR=/var/log/usos-watcher
USOS_WATCHER_LOCK=/var/lock/usos-watcher.lock
USOS_WATCHER_COOKIES=/var/lib/usos-watcher/cookies.json
